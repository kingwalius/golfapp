# Copy to .env and fill in real values for local development.
# In production these come from Vercel → Settings → Environment Variables.

# Turso / libSQL connection. The server rewrites libsql:// to https:// internally.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# JWT signing secret. Generate with: openssl rand -base64 48
# Rotating this invalidates all existing user sessions.
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48

# Admin token for destructive endpoints (nuke-db, fix-db, reset-password, etc.)
# Optional. If unset, admin endpoints return 403.
# Generate with: openssl rand -base64 48
ADMIN_TOKEN=replace-with-output-of-openssl-rand-base64-48

# Local dev only. Vercel sets this automatically in production.
# PORT=3000
